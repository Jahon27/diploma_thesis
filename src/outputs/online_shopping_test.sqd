participant customer Customer
participant cart Cart
participant product Product
participant inventory Inventory
participant order Order
participant payment Payment
participant shipping Shipping
participant notification Notification

call customer cart checkout
self cart calculateTotal
loop condition
    call cart product checkAvailability
    call product inventory checkStock
    return inventory product stockAvailable
    return product cart availabilityResult
end
alt paymentSuccessful
    call cart payment processPayment
    return payment cart paymentStatus
    alt eachCartItem
        call cart order createOrder
        call order inventory createOrder
        loop condition
            call inventory product updateStock
        end
        call order shipping createShipment
        return shipping order shipmentCreated
        call order notification sendConfirmation
        self cart clearCart
        call cart notification sendPaymentFailure
    end
else paymentFailed
    call cart notification sendOutOfStock
end